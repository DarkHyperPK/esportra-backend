{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Supabase": {
    "JwtSecret": "REPLACE_WITH_SUPABASE_JWT_SECRET",
    "JwtAudience": "authenticated",
    "JwtIssuer": "",
    "Url": "REPLACE_WITH_SUPABASE_URL",
    "ServiceKey": "REPLACE_WITH_SUPABASE_SERVICE_KEY"
  },
  "ConnectionStrings": {
    "Postgres": "REPLACE_WITH_POSTGRES_CONNECTION_STRING",
    "Redis": "localhost:6379,password=REPLACE_WITH_REDIS_PASSWORD"
  },
  "Metrics": {
    "VisitorSalt": "esportra-visitor-v1"
  },
  "Smtp": {
    "Host": "smtp.titan.email",
    "Port": "465",
    "Username": "operations@esportra.com",
    "Password": "REPLACE_WITH_SMTP_PASSWORD",
    "FromEmail": "operations@esportra.com",
    "FromName": "Esportra"
  },
  "Riot": {
    "ApiKey": "REPLACE_WITH_RIOT_API_KEY",
    "OAuthClientId": "REPLACE_WITH_RIOT_CLIENT_ID",
    "OAuthClientSecret": "REPLACE_WITH_RIOT_CLIENT_SECRET"
  },
  "Faceit": {
    "ApiKey": "REPLACE_WITH_FACEIT_API_KEY",
    "ClientId": "REPLACE_WITH_FACEIT_CLIENT_ID",
    "ClientSecret": "REPLACE_WITH_FACEIT_CLIENT_SECRET"
  },
  "Rawg": {
    "ApiKey": "REPLACE_WITH_RAWG_API_KEY"
  },
  "FrontendUrl": "https://esportra.com",
  "BackendUrl": "https://api.esportra.com",
  "PartnerUrl": "https://partner.esportra.com",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4173",
      "https://staging.esportra.com",
      "https://frontend-staging.esportra.com",
      "https://esportra.com",
      "https://www.esportra.com",
      "https://partner.esportra.com",
      "https://partners.esportra.com"
    ]
  },
  "RateLimit": {
    "Enabled": true,
    "Policies": {
      "default":  { "MaxRequests": 200,  "WindowSeconds": 60 },
      "relaxed":  { "MaxRequests": 500,  "WindowSeconds": 60 },
      "strict":   { "MaxRequests": 30,   "WindowSeconds": 60 },
      "auth":     { "MaxRequests": 10,   "WindowSeconds": 60 },
      "admin":    { "MaxRequests": 1000, "WindowSeconds": 60 }
    },
    "ExemptPaths": [ "/health", "/api/analytics/events" ],
    "ExemptPrefixes": [ "/hubs/" ],
    "PathPolicies": {
      "/api/admin/": "admin",
      "/api/auth/": "auth"
    }
  }
}