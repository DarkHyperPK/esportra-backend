{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Supabase": {
    "JwtSecret": "REPLACE_WITH_SUPABASE_JWT_SECRET",
    "JwtAudience": "authenticated",
    "JwtIssuer": "",
    "Url": "REPLACE_WITH_SUPABASE_URL",
    "AnonKey": "REPLACE_WITH_SUPABASE_ANON_KEY",
    "ServiceKey": "REPLACE_WITH_SUPABASE_SERVICE_KEY"
  },
  "ConnectionStrings": {
    "Postgres": "REPLACE_WITH_POSTGRES_CONNECTION_STRING",
    "Redis": "localhost:6379,password=REPLACE_WITH_REDIS_PASSWORD"
  },
  "Metrics": {
    "VisitorSalt": "esportra-visitor-v1"
  },
  "SponsorAnalytics": {
    "IdentityHmacKey": "REPLACE_WITH_SPONSOR_ANALYTICS_HMAC_KEY",
    "IdentityKeyVersion": 1,
    "MinimumAudience": 10,
    "IdentityLifetimeDays": 91
  },
  "Resend": {
    "ApiKey": "REPLACE_WITH_RESEND_API_KEY",
    "FromEmail": "operations@esportra.com",
    "FromName": "Esportra"
  },
  "Riot": {
    "ApiKey": "REPLACE_WITH_RIOT_API_KEY",
    "OAuthClientId": "REPLACE_WITH_RIOT_CLIENT_ID",
    "OAuthClientSecret": "REPLACE_WITH_RIOT_CLIENT_SECRET"
  },
  "Rawg": {
    "ApiKey": "REPLACE_WITH_RAWG_API_KEY"
  },
  "Igdb": {
    "ClientId": "REPLACE_WITH_IGDB_CLIENT_ID",
    "ClientSecret": "REPLACE_WITH_IGDB_CLIENT_SECRET"
  },
  "FrontendUrl": "https://esportra.com",
  "BackendUrl": "https://api.esportra.com",
  "PartnerUrl": "https://partner.esportra.com",
  "Recovery": {
    "MainRedirectUrl": "https://esportra.com/auth/recovery",
    "PartnerRedirectUrl": "https://partner.esportra.com/auth/recovery"
  },
  "RecoverySecurity": {
    "EmailHmacKey": "REPLACE_WITH_RECOVERY_EMAIL_HMAC_KEY",
    "IpHmacKey": "REPLACE_WITH_RECOVERY_IP_HMAC_KEY",
    "IpPerMinute": 5,
    "EmailPerHour": 3,
    "PairPerHour": 3,
    "EmailPerDay": 6
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4173",
      "https://staging.esportra.com",
      "https://frontend-staging.esportra.com",
      "https://esportra.com",
      "https://www.esportra.com",
      "https://partner.esportra.com",
      "https://partners.esportra.com"
    ]
  },
  "VenueHub": {
    "Url": "http://localhost:8090",
    "InternalSecret": "dev-internal-secret-change-in-production"
  },
  "RateLimit": {
    "Enabled": true,
    "Policies": {
      "default":  { "MaxRequests": 200,  "WindowSeconds": 60 },
      "relaxed":  { "MaxRequests": 500,  "WindowSeconds": 60 },
      "strict":   { "MaxRequests": 30,   "WindowSeconds": 60 },
      "auth":     { "MaxRequests": 10,   "WindowSeconds": 60 },
      "admin":    { "MaxRequests": 1000, "WindowSeconds": 60 },
      "sponsorAnalytics": { "MaxRequests": 120, "WindowSeconds": 60 }
    },
    "ExemptPaths": [ "/health" ],
    "ExemptPrefixes": [ "/hubs/" ],
    "PathPolicies": {
      "/api/admin/": "admin",
      "/api/auth/": "auth"
    }
  },
  "Authorization": {
    "EnforceMode": false
  }
}