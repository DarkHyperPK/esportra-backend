<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Workaround: SDK 9.0.300 path-case bug on Windows — same file discovered twice (d:\ vs D:\)
         causing DiscoverPrecompressedAssets and fingerprinting conflicts -->
    <StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="9.4.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.11.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Esportra.Core\Esportra.Core.csproj" />
    <ProjectReference Include="..\Esportra.Infrastructure\Esportra.Infrastructure.csproj" />
    <ProjectReference Include="..\Esportra.Contracts\Esportra.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="GameCatalog\esportsGames.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="GameCatalog\game-banner-seed.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\R6Maps\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Esportra.Api.Tests" />
  </ItemGroup>

</Project>
